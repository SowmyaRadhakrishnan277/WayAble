# The public providers below are suitable for development and a hackathon demo.
# Use a descriptive contact address before deploying a public service.
WAYABLE_USER_AGENT=WayAble/0.1 (hackathon@example.com)
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
# This public OSRM deployment runs a pedestrian graph. Its API path still uses
# the conventional `driving` profile segment; do not replace it with a car router.
OSRM_BASE_URL=https://routing.openstreetmap.de/routed-foot
OSRM_ROUTE_PROFILE=driving
OVERPASS_BASE_URL=https://overpass-api.de/api/interpreter
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Optional: NTA credentials and source URLs. These are deliberately not used by
# walking-only requests. They enable the next multimodal adapter after the GTFS
# feed fields and permitted API endpoints have been verified.
NTA_API_KEY=
NTA_GTFS_STATIC_URL=
NTA_GTFS_REALTIME_URL=

# Optional official, machine-readable Irish Rail lift-status feed. Leave blank
# until a suitable supported endpoint is confirmed; do not scrape alert pages.
IRISH_RAIL_LIFT_STATUS_URL=
